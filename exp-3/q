#include <stdio.h>

int trap_rain_water(int heights[], int n) {
    // A minimum of 3 buildings is required to trap any water
    if (n <= 2) return 0;

    int left = 0;
    int right = n - 1;
    
    int left_max = 0;
    int right_max = 0;
    
    int trapped_water = 0;

    while (left < right) {
        // We process the side with the smaller height first, 
        // because the smaller side acts as the bottleneck for water.
        if (heights[left] < heights[right]) {
            // Update left maximum if current building is taller
            if (heights[left] >= left_max) {
                left_max = heights[left];
            } 
            // Otherwise, water is trapped!
            else {
                trapped_water += left_max - heights[left];
            }
            left++; // Move the left pointer inward
        } 
        else {
            // Update right maximum if current building is taller
            if (heights[right] >= right_max) {
                right_max = heights[right];
            } 
            // Otherwise, water is trapped!
            else {
                trapped_water += right_max - heights[right];
            }
            right--; // Move the right pointer inward
        }
    }

    return trapped_water;
}

int main() {
    // Example building heights
    int buildings[] = {0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1};
    int n = sizeof(buildings) / sizeof(buildings[0]);

    int water = trap_rain_water(buildings, n);
    
    printf("Total trapped rainwater: %d units\n", water);

    return 0;
}